datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model Room { id String @id @default(cuid()) code String @unique judgeTokenHash String judgeRecoveryHash String @default("") status String state Json settings Json maxPlayers Int @default(3) createdAt DateTime @default(now()) endedAt DateTime? tokens Json @default("{}") players Player[] events GameEvent[] usedQuestions RoomQuestion[] }
model Player { id String @id @default(cuid()) roomId String room Room @relation(fields: [roomId], references: [id]) name String tokenHash String @default("") score Int @default(0) isEliminated Boolean @default(false) isConnected Boolean @default(false) powerupKey String? powerupState String @default("none") joinedAt DateTime @default(now()) lastSeenAt DateTime? @@unique([roomId, name]) @@unique([roomId, powerupKey]) }
model Category { id String @id @default(cuid()) slug String @unique name String isCustom Boolean @default(false) roomId String? questions Question[] }
model Question { id String @id @default(cuid()) categoryId String category Category @relation(fields: [categoryId], references: [id]) text String answer String acceptedAnswers String[] @default([]) type String difficulty String options Json? correctIndex Int? mediaUrl String? mediaType String? mediaCredit String? letter String? answerMode String @default("single") isActive Boolean @default(true) normalizedHash String @unique usageCount Int @default(0) createdAt DateTime @default(now()) }
model RoomQuestion { roomId String questionId String order Int usedAt DateTime? @@id([roomId, questionId]) }
model Submission { id String @id @default(cuid()) roomId String questionId String playerId String payload Json judged Boolean @default(false) isCorrect Boolean? points Int @default(0) createdAt DateTime @default(now()) @@unique([roomId, questionId, playerId]) }
model GameEvent { id String @id @default(cuid()) roomId String room Room @relation(fields: [roomId], references: [id]) seq Int type String actorId String? payload Json createdAt DateTime @default(now()) @@unique([roomId, seq]) }
